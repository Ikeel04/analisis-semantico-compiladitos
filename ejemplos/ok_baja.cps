// Ejemplo: complejidad baja, sin errores léxicos ni sintácticos.
// Análisis léxico y sintáctico de un archivo de entrada con complejidad baja.

let a: integer = 5;
let b: string = "hola";
let c: boolean = true;

print(a + 3);
print(b);

if (a > 2) {
  print("a es mayor");
}

let d = a * 2 - 1;
print(d);

while (d > 0) {
  d = d - 1;
}
print(d);
